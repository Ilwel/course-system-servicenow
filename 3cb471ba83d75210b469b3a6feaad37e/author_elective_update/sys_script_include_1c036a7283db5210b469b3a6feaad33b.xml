        <script><![CDATA[var CourseScheduleAjaxUtils = Class.create();
CourseScheduleAjaxUtils.prototype = {
    initialize: function() {
    },

	getEncodedQuery: function(){
		const encodedQuery = this.getParameter("sysparam_encoded_query");
		const results = []
		if(encodedQuery){
			let gr = new GlideRecord("x_1593190_course_0_course_schedule");
			gr.encodedQuery(encodedQuery);
			gr.query();
			while(gr.next()){
				results.push({
					sys_id: gr.sys_id,
					course: gr.course.name
				});
			}
			return JSON.stringify(results);
		}
		return "";
	},

    type: 'CourseScheduleAjaxUtils'
};]]></script>
